      "program": "{{app_dir}}/bin/mysqld.exe",
      "args": ["--defaults-file={{conf_file}}", "--console"]
    },
    "stop_cmd": {
      "program": "{{app_dir}}/bin/mysqladmin.exe",
      "args": ["-u", "root", "-P", "{{port}}", "shutdown"]
    }
  },
